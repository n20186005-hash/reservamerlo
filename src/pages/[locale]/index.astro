---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { translations, type Locale } from '../../i18n/translations';
import { getSeo } from '../../lib/seo';
import galleryImagesData from '../../gallery-data.json';

export function getStaticPaths() {
  return (['es', 'en', 'zh', 'it'] as Locale[]).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = translations[locale];
const seo = getSeo(locale);
const MAPS_URL = 'https://maps.app.goo.gl/cUvY92vJJYcx1b9n7';
const GALLERY_PLAN = [
  { key: 'flora', from: 0, to: 5 },
  { key: 'fauna', from: 6, to: 11 },
  { key: 'landscape', from: 12, to: 16 },
  { key: 'trails', from: 17, to: 21 },
];
function categoryForIndex(i: number): string {
  const plan = GALLERY_PLAN.find((p) => i >= p.from && i <= p.to);
  return plan ? plan.key : 'flora';
}
const galleryImages = (galleryImagesData as string[]).map((src, i) => ({ src, category: categoryForIndex(i) }));
const ALL_LABELS: Record<Locale, string> = { zh: '全部', en: 'All', es: 'Todas', it: 'Tutte' };

const MARKER_POS: Record<string, { top: string; left: string }> = {
  entrada: { top: '74%', left: '16%' },
  iglesia: { top: '56%', left: '38%' },
  monumento: { top: '28%', left: '54%' },
  corrales: { top: '70%', left: '70%' },
  necrópolis: { top: '44%', left: '84%' },
};

const LANG_LABELS: Record<Locale, string> = { zh: '中文', en: 'EN', es: 'ES', it: 'IT' };

const GOOGLE_REVIEWS = [
  { name: 'Lucía M.', avatar: 'LM', rating: 5, date: '2025-06-18', text: 'La Reserva de Rincón del Este es un lujo de tranquilidad. Caminamos los senderos interpretativos al amanecer y vimos chimangos, colibríes y hasta una vizcacha entre las rocas. Ideal para ir con la familia desde Merlo.' },
  { name: 'Tom H.', avatar: 'TH', rating: 5, date: '2025-05-22', text: 'A hidden gem near Merlo. The native woodland and the sierra light are beautiful, and the guides explained the flora without rushing. Bring water and a hat — the sun is no joke here.' },
  { name: 'Sofia R.', avatar: 'SR', rating: 5, date: '2025-04-30', text: 'Posto incantevole e tranquillo. Abbiamo fatto il sentiero e il mirador sulla quebrada: luce dorata e silenzio. Perfetto per il birdwatching, portate il binocolo. Merlo è vicinissima.' },
  { name: '陈静', avatar: '陈', rating: 5, date: '2025-03-15', text: 'Rincón del Este 太安静治愈了！清晨的原生丛林里鸟鸣不断，向导还讲了科梅琴戈内斯人的彩绘石传说。从梅洛镇开车几分钟就到，非常适合亲子。记得带水和防晒。' },
  { name: 'Mateo F.', avatar: 'MF', rating: 4, date: '2025-02-08', text: 'Muy buena opción para una mañana en Merlo. Los senderos están bien señalizados y el mirador vale la pena. Ojo con el sol y llevar repelente en verano; el ingreso es un aporte módico.' },
  { name: 'Ana P.', avatar: 'AP', rating: 5, date: '2024-11-12', text: 'Volví varias veces y siempre sorprende. La reserva cuida de verdad el monte nativo y las mariposas en primavera son una joya. Imperdible si estás en San Luis y querés naturaleza sin multitudes.' },
];

function renderText(text: string): string {
  if (!text) return '';
  return text
    .split(/(\*\*.*?\*\*)/g)
    .map((part) => {
      if (part.startsWith('**') && part.endsWith('**')) return `<strong>${part.slice(2, -2)}</strong>`;
      return part;
    })
    .join('');
}

const transportSections = [
  {
    title: t.transportation.airport.title,
    content: t.transportation.airport.content,
    options: t.transportation.airport.options,
  },
  ...(t.transportation.publicTransport
    ? [{ title: t.transportation.publicTransport.title, content: t.transportation.publicTransport.content, options: t.transportation.publicTransport.options }]
    : []),
  {
    title: t.transportation.city.title,
    content: t.transportation.city.content,
    steps: t.transportation.city.steps,
  },
];

