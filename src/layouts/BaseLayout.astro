---
import '../styles/globals.css';
import '../styles/additions.css';
import { localeConfig, type Locale } from '../i18n/config';
import { getSeo } from '../lib/seo';
import { generateSchema } from '../lib/schema';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
  breadcrumb?: { name: string; url: string }[];
  ogTitle?: string;
  ogDescription?: string;
  includeSchema?: boolean;
}

const { locale, title, description, path, breadcrumb, ogTitle, ogDescription, includeSchema = true } = Astro.props as Props;
const cfg = localeConfig[locale] || localeConfig.es;
const site = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://reservamerlo.com';
const relPath = path ?? `/${locale}/`;
const canonical = `${site}${relPath}`;
const localeMatch = relPath.match(/^\/(es|en|zh|it)(\/.*)?$/);
const alternates: Record<string, string> = localeMatch
  ? {
      es: `${site}/es${localeMatch[2] || '/'}`,
      en: `${site}/en${localeMatch[2] || '/'}`,
      zh: `${site}/zh${localeMatch[2] || '/'}`,
      it: `${site}/it${localeMatch[2] || '/'}`,
    }
  : {};
const ogImage = `${site}/gallery/reservamerlo-1.jpg`;
const seo = getSeo(locale);
const schema = includeSchema ? generateSchema(locale, site) : null;
const breadcrumbSchema = breadcrumb
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/${locale}/` },
        ...breadcrumb.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: b.name,
          item: `${site}${b.url}`,
        })),
      ],
    }
  : null;
---

<!doctype html>
<html lang={cfg.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    {
      Object.keys(alternates).length > 0 && (
        <>
          {Object.entries(alternates).map(([l, url]) => (
            <link rel="alternate" hreflang={l} href={url} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternates.es} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={cfg.ogLocale} />
    {
      Object.values(localeConfig)
        .filter((c) => c.ogLocale !== cfg.ogLocale)
        .map((c) => <meta property="og:alternate_locale" content={c.ogLocale} />)
    }
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle ?? seo.ogTitle} />
    <meta property="og:description" content={ogDescription ?? seo.ogDescription} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.ogTitle} />
    <meta name="twitter:description" content={seo.ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121212" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    {/* 在绘制前设置主题，避免闪烁 */}
    <script
      is:inline
      set:html={`(function(){try{var t=localStorage.getItem('theme');if(t!=='light'&&t!=='dark'){t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}document.documentElement.setAttribute('data-theme',t);}catch(e){document.documentElement.setAttribute('data-theme','light');}})();`}
    ></script>

    {
      includeSchema && schema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>
      )
    }
    {
      breadcrumbSchema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)}></script>
      )
    }
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
